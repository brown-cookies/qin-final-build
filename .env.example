# Copy to .env for local runs. Dev-only values, no secrets.
DATABASE_URL=postgresql://biyahe:biyahe@127.0.0.1:5432/biyahe
SERVICE_BBOX=15.08,15.22,120.50,120.68
WALK_RADIUS_M=500
TRANSFER_RADIUS_M=100
TRANSFER_PENALTY_KM=1.0
WALK_COST_FACTOR=2.0
# Not in SPEC Section 10: max seconds to wait for a DB connection (also the startup wait)
DB_POOL_TIMEOUT_S=3
# Tests only: must be a database whose name ends in _test
TEST_DATABASE_URL=postgresql://biyahe:biyahe@127.0.0.1:5432/biyahe_test
